# Deny all direct web access to contact logs and rate-limit counters.
# (Apache 2.4 / 2.2 portable form.)
#
# The storage/ directory holds messages.csv and per-IP rate-limit files
# from api/contact.php — they contain submitted names, emails, and message
# bodies, so they must never be fetched over HTTP. PHP still reads/writes
# them on the filesystem; this only blocks web requests.
#
# nginx / hosts with .htaccess disabled: do NOT rely on this file. Move
# storage/ above the web root and update the STORAGE constant in
# api/contact.php to point at the absolute path.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

# Belt-and-suspenders: don't let any handler execute these as scripts,
# and don't render a directory index if autoindex is on.
<FilesMatch "\.(csv|json|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
